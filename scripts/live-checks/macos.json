[
 {
  "tool": "relay_probe",
  "show": 300
 },
 {
  "tool": "relay_acquire",
  "args": {
   "task": "live-check-macos",
   "image": "macos26",
   "extractions": []
  },
  "stopOnError": true,
  "show": 300
 },
 {
  "tool": "relay_stage",
  "args": {
   "nodePath": "/usr/local/bin/node"
  },
  "stopOnError": true,
  "show": 300
 },
 {
  "tool": "relay_run",
  "label": "cua get_screen_size",
  "args": {
   "target": "cua",
   "tool": "get_screen_size",
   "args": {}
  }
 },
 {
  "tool": "relay_run",
  "label": "cua launch Calculator",
  "args": {
   "target": "cua",
   "tool": "launch_app",
   "args": {
    "bundle_id": "com.apple.calculator"
   }
  },
  "capture": {
   "pid": "\"pid\": (\\d+)"
  },
  "stopOnError": true,
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "cua list_windows",
  "args": {
   "target": "cua",
   "tool": "list_windows",
   "args": {
    "pid": "${pid:int}"
   }
  },
  "capture": {
   "window": "\"title\": \"Calculator\",\\s*\"window_id\": (\\d+)"
  },
  "stopOnError": true,
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "cua get_window_state",
  "args": {
   "target": "cua",
   "tool": "get_window_state",
   "args": {
    "pid": "${pid:int}",
    "window_id": "${window:int}"
   }
  },
  "capture": {
   "seven": "\\[(\\d+)\\] AXButton \\(7\\)"
  },
  "stopOnError": true,
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "cua click 7",
  "args": {
   "target": "cua",
   "tool": "click",
   "args": {
    "pid": "${pid:int}",
    "window_id": "${window:int}",
    "element_index": "${seven:int}"
   }
  },
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "cua click 7 again (after-snapshot shows 77)",
  "args": {
   "target": "cua",
   "tool": "click",
   "args": {
    "pid": "${pid:int}",
    "window_id": "${window:int}",
    "element_index": "${seven:int}"
   }
  },
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "playwright navigate",
  "args": {
   "target": "playwright",
   "tool": "browser_navigate",
   "args": {
    "url": "https://example.com"
   }
  },
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "playwright snapshot",
  "args": {
   "target": "playwright",
   "tool": "browser_snapshot",
   "args": {}
  },
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "chrome-devtools navigate",
  "args": {
   "target": "chrome-devtools",
   "tool": "navigate_page",
   "args": {
    "type": "url",
    "url": "https://example.org"
   }
  },
  "show": 200
 },
 {
  "tool": "relay_run",
  "label": "chrome-devtools screenshot",
  "args": {
   "target": "chrome-devtools",
   "tool": "take_screenshot",
   "args": {}
  },
  "show": 200
 },
 {
  "tool": "relay_finish",
  "show": 1200
 }
]